; Project Wuming - pinned toolchain in .godot-version
config_version=5

[application]
config/name="Project Wuming"
config/version="0.2.1-week2"
run/main_scene="res://game/presentation/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="ProjectWuming"

[autoload]
App="*res://game/core/bootstrap/app.gd"
GameSession="*res://game/core/services/game_session.gd"
ContentDB="*res://game/core/services/content_db.gd"
SaveService="*res://game/persistence/save_service.gd"
PlatformService="*res://game/platform/offline/offline_platform_service.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/borderless=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.09, 0.094, 0.125, 1)

[internationalization]
locale/translations=PackedStringArray("res://game/content/localization/ui.zh_CN.translation", "res://game/content/localization/ui.en.translation", "res://game/content/localization/exploration.zh_CN.translation", "res://game/content/localization/exploration.en.translation", "res://game/content/localization/investigation.zh_CN.translation", "res://game/content/localization/investigation.en.translation")
locale/fallback="zh_CN"

[input]
move_up={
"deadzone":0.25,
"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadButton,"button_index":11),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1)]
}
move_down={
"deadzone":0.25,
"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadButton,"button_index":12),Object(InputEventJoypadMotion,"axis":1,"axis_value":1)]
}
move_left={
"deadzone":0.25,
"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadButton,"button_index":13),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1)]
}
